{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medmachina.github.io/schemas/companies.schema.json",
    "title": "Companies Dataset",
    "$defs": {
      "UrlEntry": {
        "type": "object",
        "required": ["caption", "url"],
        "properties": {
          "caption": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "archive_url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Wayback Machine or web archive snapshot URL."
          }
        },
        "additionalProperties": false
      },
      "CompanyStatusEntry": {
        "type": "object",
        "description": "Current corporate operating status.",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "acquired",
              "merged",
              "defunct",
              "liquidated",
              "restructuring"
            ],
            "description": "Corporate status: active, acquired, merged, defunct (ceased operations), liquidated (wound up), restructuring (e.g. insolvency proceedings)."
          },
          "year": {
            "type": ["integer", "null"],
            "minimum": 1900,
            "maximum": 2100,
            "description": "Year when the corporate event occurred."
          },
          "successor": {
            "type": ["string", "null"],
            "description": "Successor company ID or legal entity name (e.g. karl_storz, Conavi Medical Corp)."
          },
          "note": {
            "type": "string",
            "description": "Factual context explaining the corporate change."
          },
          "source_url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Authoritative source URL documenting the status."
          }
        },
        "additionalProperties": false
      }
    },
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "country"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.&]+$",
        "description": "Unique company identifier."
      },
      "name": {"type": "string", "minLength": 1},
      "country": {"type": "string", "minLength": 1},
      "description": {"type": "string"},
      "employee_count": {"type": ["integer", "string", "null"]},
      "founded_year": {"type": ["string", "null"], "pattern": "^(19|20)\\d{2}$"},
      "company_type": {"type": ["string", "null"]},
      "linkedin_url": {"type": ["string", "null"], "format": "uri"},
      "opencorporates_url": {"type": ["string", "null"], "format": "uri"},
      "urls": {"type": "array", "items": {"$ref": "#/$defs/UrlEntry"}},
      "status": {
        "$ref": "#/$defs/CompanyStatusEntry"
      },
      "robots": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Za-z0-9_.&]+$"},
        "uniqueItems": true,
        "description": "List of robot IDs associated with the company. Allowed characters: letters, digits, underscore, period, ampersand."
      },
      "subsidiaries": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true,
        "description": "List of subsidiary companies, acquired brands, or alternative applicant names used in regulatory filings."
      },
      "patents": {
        "type": "object",
        "properties": {
          "assignee_names": {
            "type": "array",
            "items": {"type": "string"}
          },
          "google_patents_url": {"type": "string", "format": "uri"},
          "lens_url": {"type": "string", "format": "uri"},
          "count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  }
}